# ============================================================
#  SentinelOps AI — Environment Template
#  Copy this file to .env and fill in real values.
#  NEVER commit .env with real credentials.
# ============================================================

# ── IBM watsonx AI Credentials ───────────────────────────────
IBM_WATSONX_API_KEY=your-ibm-watsonx-api-key-here
IBM_WATSONX_PROJECT_ID=your-project-id-here
IBM_WATSONX_ENDPOINT=https://us-south.ml.cloud.ibm.com/ml/v1/text/chat?version=2023-05-29
IBM_WATSONX_REGION=us-south

# ── Backend (FastAPI) ─────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-long-random-string-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite:///./sentinelops.db
COLLECTOR_DB_URL=sqlite:///./collector_buffer.db

# ── Collector ────────────────────────────────────────────────
COLLECTOR_API_KEY=your-collector-api-key
COLLECTOR_TENANT_ID=tenant-alpha
COLLECTOR_SOURCE_ID=src-server-01
COLLECTOR_REGION=us-south
SAAS_INGEST_URL=http://localhost:8000/api/v1/telemetry/ingest
SAAS_HEARTBEAT_URL=http://localhost:8000/api/v1/collectors/heartbeat
COLLECTOR_HEARTBEAT_INTERVAL_SECONDS=15
COLLECTOR_OFFLINE_THRESHOLD_SECONDS=60
COLLECTOR_RETRY_MAX_ATTEMPTS=10
COLLECTOR_RETRY_BASE_DELAY_SECONDS=2

# ── Telemetry Simulator ───────────────────────────────────────
SIMULATOR_ENABLED=true
SIMULATOR_EMIT_INTERVAL_SECONDS=5
SIMULATOR_TENANT_IDS=tenant-alpha,tenant-beta

# ── Multi-Tenant ─────────────────────────────────────────────
DEFAULT_TENANT_ALPHA_ID=tenant-alpha
DEFAULT_TENANT_BETA_ID=tenant-beta

# ── CORS / Frontend ──────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── TLS ───────────────────────────────────────────────────────
# TLS_CERT_FILE=./certs/cert.pem
# TLS_KEY_FILE=./certs/key.pem

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
AUDIT_LOG_FILE=./logs/audit.jsonl

# ── Local Collector UI ────────────────────────────────────────
COLLECTOR_LOCAL_UI_PORT=8001
